# Copy to .env and change what you need. Every line is optional.

# Where finished files land (a folder on this computer).
# Windows (Docker Desktop):  C:/Users/<you>/Downloads/MediaHarvest
# Linux / WSL:               /home/<you>/Downloads/MediaHarvest
MEDIAHARVEST_DOWNLOADS=./downloads

# Optional separate folders; each one left out uses the download folder.
# On Windows the Settings page sets these through the desktop shortcut.
# Audio downloads (also uncomment the _DIR line):
# MEDIAHARVEST_MUSIC=C:/Users/<you>/Music/MediaHarvest
# MEDIAHARVEST_MUSIC_DIR=/music
# Downloads in progress, ideally on a fast drive (also uncomment the _DIR line):
# MEDIAHARVEST_TEMP=D:/MediaHarvest-work
# MEDIAHARVEST_TEMP_DIR=/temp
# Lists and settings (default: .metube in the download folder):
# MEDIAHARVEST_STATE=C:/Users/<you>/AppData/Local/MediaHarvest/state

# Port on this computer: open http://localhost:<port>
MEDIAHARVEST_PORT=8081

# Image version to run: latest, or a fixed one such as 2026.11.10-abc1234
MEDIAHARVEST_TAG=latest

# Owner of the downloaded files on Linux (run `id -u` / `id -g`).
MEDIAHARVEST_UID=1000
MEDIAHARVEST_GID=1000

# Use an NVIDIA graphics card for compressing (see docker-compose.gpu.yml).
# Linux / WSL: separate with ":"; Windows: with ";".
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
